@using traveling_salesman_problem_wasm.Algorithms.Utilidades
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="graphviz-render">
    @if (error is not null)
    {
        <p style="color:red; white-space:pre-wrap;">@error</p>
    }
    else
    {
        <div class="graphviz-panel @(imagenDespues is null ? "graphviz-panel-unico" : null)">
            <figure class="graphviz-figura">
                <figcaption>@(imagenDespues is null ? "Grafo" : "Grafo original")</figcaption>
                @((MarkupString)imagenAntes)
            </figure>

            @if (imagenDespues is not null)
            {
                <figure class="graphviz-figura">
                    <figcaption>Ciclo hamiltoniano</figcaption>
                    @((MarkupString)imagenDespues)
                </figure>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int[][]? Matriz { get; set; }
    [Parameter] public int VerticeInicio { get; set; } = 0;
    [Parameter] public List<int>? Ruta { get; set; }
    [Parameter] public string? NombreGrafico { get; set; }
    [Parameter] public bool EsDirigido { get; set; }
    [Parameter] public IReadOnlyList<string>? Etiquetas { get; set; }

    private IJSObjectReference? _json;
    private string imagenAntes = "";
    private string? imagenDespues;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        if (_json is not null)
            await RenderAsync();
    }

    protected override async Task OnAfterRenderAsync(bool primerRender)
    {
        if (primerRender)
        {
            _json = await JS.InvokeAsync<IJSObjectReference>("import", "./js/graphvizWasm.js");
            await RenderAsync();
            StateHasChanged();
        }
    }

    private async Task RenderAsync()
    {
        error = null;
        try
        {
            if(string.IsNullOrEmpty(NombreGrafico))
                NombreGrafico = "Grafo ponderado";
            imagenAntes = "";
            imagenDespues = null;

            string dotAntes = ConversorDotFiles.CrearDotFile(
                Matriz,
                VerticeInicio,
                nombreGrafico: NombreGrafico,
                camino: null,
                esDirigido: EsDirigido,
                etiquetas: Etiquetas);

            if (string.IsNullOrEmpty(dotAntes))
                return;

            var dots = new List<string> { dotAntes };

            if (Ruta is { Count: > 1 })
                dots.Add(ConversorDotFiles.CrearDotFile(
                    Matriz,
                    VerticeInicio,
                    nombreGrafico: NombreGrafico,
                    camino: Ruta,
                    esDirigido: EsDirigido,
                    etiquetas: Etiquetas,
                    ocultarOtrasAristas: true));

            string[] svgs = await _json!.InvokeAsync<string[]>("renderDots", (object)dots.ToArray());
            imagenAntes = svgs[0];
            imagenDespues = svgs.Length > 1 ? svgs[1] : null;
        }
        catch (ArgumentException ex)
        {
            error = ex.Message;
        }
        catch (JSException ex)
        {
            error = $"Error al renderizar el grafo:\n{ex.Message}";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_json is not null)
        {
            try { await _json.DisposeAsync(); }
            catch (JSDisconnectedException) {}
        }
    }
}
