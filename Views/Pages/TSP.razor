@page "/tsp"
@using System.Diagnostics
@using traveling_salesman_problem_wasm.Algorithms
@using traveling_salesman_problem_wasm.Algorithms.Utilidades
@using traveling_salesman_problem_wasm.Models
@using traveling_salesman_problem_wasm.Services
@using traveling_salesman_problem_wasm.Views.Ciudades
@using traveling_salesman_problem_wasm.Views.Matriz
@using traveling_salesman_problem_wasm.Views.Graphviz
@inject IJSRuntime JS
@inject HttpClient Http
@implements IAsyncDisposable

<PageTitle>Problema del agente viajero</PageTitle>

<h1>Problema del agente viajero (TSP)</h1>

<section class="panel-configuracion">
    <h3>Configuración del grafo</h3>

    <div role="group" aria-label="Origen de los datos del grafo">
        <button type="button"
                disabled="@(!modoCiudades)"
                @onclick="() => CambiarModo(false)">
            Matriz manual
        </button>
        <button type="button"
                disabled="@modoCiudades"
                @onclick="() => CambiarModo(true)">
            Ciudades (distancias automáticas)
        </button>
    </div>

    @if (modoCiudades)
    {
        <p class="texto-ayuda">
            Busca ciudades por nombre y agrégalas: la matriz se genera automáticamente con la distancia por
            carretera en kilómetros (OSRM sobre OpenStreetMap) y la ruta se dibuja sobre las vías reales.
            Si el servicio no responde se usa la distancia en línea recta (Haversine). Necesitas al menos 3 ciudades.
        </p>

        <BuscadorCiudades Ciudades="ciudadesTSP"
                          AlAgregar="AgregarCiudadTSP"
                          AlQuitar="QuitarCiudadTSP"
                          Maximo="MaximoCiudades" />

        @if (ciudadesTSP.Count is > 0 and < 3)
        {
            <p>Agrega al menos 3 ciudades para poder resolver el TSP.</p>
        }

        <div id="mapa-tsp-ciudades"
             class="mapa-tsp"
             role="application"
             aria-label="Mapa de OpenStreetMap con las ciudades seleccionadas"></div>

        @if (!string.IsNullOrEmpty(mensajeMapa))
        {
            <p>@mensajeMapa</p>
        }
    }
    else
    {
        <p class="texto-ayuda">
            Elige el tamaño, el tipo de grafo, el rango de pesos y el grado máximo de los vértices.
            El botón <strong>Limitar grado</strong> recorta automáticamente las aristas necesarias conservando
            un ciclo hamiltoniano.
        </p>

        <MatizEditor Minimo="5"
                     Maximo="16"
                     EsDirigido="esDirigido"
                     EsDirigidoChanged="AlCambiarTipoGrafo"
                     MatrizCambiada="ManejadorCambiosMatriz" />
    }

    @if (cargandoDistancias)
    {
        <p class="texto-ayuda" aria-live="polite">Calculando distancias por carretera...</p>
    }

    @if (!string.IsNullOrEmpty(resumenGrafo))
    {
        <p class="resumen-grafo">@resumenGrafo</p>
    }

    @if (!string.IsNullOrEmpty(avisoDistancias))
    {
        <p>@avisoDistancias</p>
    }
</section>

<section class="panel-configuracion">
    <h3>Resolver</h3>

    <div class="matriz-controles">
        <div class="campo-editor">
            <label for="algoritmo-resolucion">Algoritmo</label>
            <select id="algoritmo-resolucion" @bind="algoritmo">
                <option value="@AlgoritmoResolucion.FuerzaBruta">Fuerza bruta (Solucion exacta)</option>
                <option value="@AlgoritmoResolucion.DosOpt">Heuristica 2-opt (Aproximado bueno y rápido)</option>
            </select>
        </div>

        <div class="campo-editor">
            <label for="vertice-origen">Vértice de origen</label>
            <select id="vertice-origen" @bind="verticeInicio">
                @for (int i = 0; i < (matrizActual?.Length ?? 0); i++)
                {
                    <option value="@i">@NombreVertice(i)</option>
                }
            </select>
        </div>

        <div class="grupo-botones">
            <button type="button" @onclick="Procesar" disabled="@(estaProcesando || cargandoDistancias)">
                @(estaProcesando ? "Procesando..." : "Procesar")
            </button>
        </div>
    </div>

    @if (algoritmo == AlgoritmoResolucion.DosOpt)
    {
        <p class="texto-ayuda">
            2-opt parte de una ruta inicial (vecino más cercano) y la mejora invirtiendo tramos.
            Es una heurística: consigue una buena ruta, no necesariamente la óptima.
        </p>
    }

    @if (!string.IsNullOrEmpty(advertenciaFuerzaBruta))
    {
        <p>@advertenciaFuerzaBruta</p>
    }
</section>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <p>@mensajeError</p>
}

@if (!string.IsNullOrEmpty(rutaStr))
{
    <section class="resultados-tsp" aria-live="polite">
        @if (!string.IsNullOrEmpty(ciclosStr))
        {
            <div class="tarjeta-resultado">
                <span>Ciclos posibles</span>
                <strong>@ciclosStr</strong>
            </div>
        }

        <div class="tarjeta-resultado">
            <span>Algoritmo</span>
            <strong>@algoritmoStr</strong>
        </div>

        <div class="tarjeta-resultado tarjeta-ancha">
            <span>Ruta</span>
            <strong>@rutaStr</strong>
        </div>

        <div class="tarjeta-resultado">
            <span>Costo total</span>
            <strong>@costoStr</strong>
        </div>

        <div class="tarjeta-resultado">
            <span>Tiempo</span>
            <strong>@tiempoStr</strong>
        </div>
    </section>
}

<GraphvizRender Matriz="matrizActual"
                VerticeInicio="verticeInicio"
                Ruta="ultimaSolucion"
                EsDirigido="esDirigido"
                Etiquetas="etiquetasGrafo"
                NombreGrafico="Grafo_TSP" />

@code {
    private enum AlgoritmoResolucion
    {
        FuerzaBruta,
        DosOpt
    }

    private const int LimiteFuerzaBruta = 16;
    private const int MinimoCiudades = 3;
    private const int MaximoCiudades = 20;

    private AlgoritmoResolucion algoritmo = AlgoritmoResolucion.FuerzaBruta;
    private string algoritmoStr = string.Empty;

    private readonly List<CiudadOSM> ciudadesTSP = new();

    private int[][]? matrizActual;
    private bool esDirigido;
    private bool estaProcesando;
    private bool cargandoDistancias;
    private bool distanciasPorCarretera;
    private int versionMatriz;
    private double[][]? trazadoRuta;
    private string? avisoDistancias;
    private bool modoCiudades;
    private bool modoCiudadesAnterior;
    private bool mapaPendiente;
    private int verticeInicio;
    private List<int>? ultimaSolucion;
    private IJSObjectReference? moduloMapa;

    private string? ciclosStr;
    private string? rutaStr;
    private string? costoStr;
    private string? tiempoStr;
    private string? mensajeError;
    private string? mensajeMapa;
    private string? resumenGrafo;

    private IReadOnlyList<string>? etiquetasGrafo
        => modoCiudades && ciudadesTSP.Count > 0
            ? ciudadesTSP.Select(ciudad => ciudad.Nombre).ToList()
            : null;

    private string? advertenciaFuerzaBruta
        => algoritmo == AlgoritmoResolucion.FuerzaBruta
            && matrizActual is not null
            && matrizActual.Length > LimiteFuerzaBruta
            ? $"La fuerza bruta es inviable con {matrizActual.Length} vértices. Usa 2-opt o reduce el tamaño a {LimiteFuerzaBruta} o menos."
            : null;

    private void ManejadorCambiosMatriz(int[][]? matriz)
    {
        matrizActual = matriz;

        if (matrizActual is not null)
            verticeInicio = Math.Clamp(verticeInicio, 0, matrizActual.Length - 1);

        LimpiarResultados();
        ActualizarResumenGrafo();
    }

    private void AlCambiarTipoGrafo(bool dirigido)
    {
        esDirigido = dirigido;
        LimpiarResultados();
        ActualizarResumenGrafo();
    }

    private async Task CambiarModo(bool ciudades)
    {
        if (modoCiudades == ciudades)
            return;

        modoCiudades = ciudades;
        LimpiarResultados();
        mensajeMapa = null;

        if (ciudades)
        {
            esDirigido = false;
            await ActualizarMatrizCiudades();
        }
        else
        {
            versionMatriz++;
            cargandoDistancias = false;
            avisoDistancias = null;
            matrizActual = null;
            resumenGrafo = null;
            verticeInicio = 0;
            mapaPendiente = false;
        }
    }

    private async Task AgregarCiudadTSP(CiudadOSM ciudad)
    {
        if (ciudadesTSP.Count >= MaximoCiudades || ciudadesTSP.Any(c => EsMismaCiudad(c, ciudad)))
            return;

        ciudadesTSP.Add(ciudad);
        await ActualizarMatrizCiudades();
    }

    private async Task QuitarCiudadTSP(CiudadOSM ciudad)
    {
        int indice = ciudadesTSP.FindIndex(seleccionada => EsMismaCiudad(seleccionada, ciudad));

        if (indice < 0)
            return;

        CiudadOSM? ciudadOrigen = verticeInicio < ciudadesTSP.Count ? ciudadesTSP[verticeInicio] : null;

        ciudadesTSP.RemoveAt(indice);

        int nuevoIndice = ciudadOrigen is null ? -1 : ciudadesTSP.IndexOf(ciudadOrigen);
        verticeInicio = nuevoIndice >= 0 ? nuevoIndice : 0;

        await ActualizarMatrizCiudades();
    }

    private static bool EsMismaCiudad(CiudadOSM a, CiudadOSM b)
        => a.Nombre == b.Nombre
            && Math.Abs(a.Latitud - b.Latitud) < 0.0001
            && Math.Abs(a.Longitud - b.Longitud) < 0.0001;

    private async Task ActualizarMatrizCiudades()
    {
        LimpiarResultados();

        esDirigido = false;
        avisoDistancias = null;
        verticeInicio = Math.Clamp(verticeInicio, 0, Math.Max(0, ciudadesTSP.Count - 1));
        int version = ++versionMatriz;

        if (ciudadesTSP.Count < MinimoCiudades)
        {
            matrizActual = null;
            cargandoDistancias = false;
            ActualizarResumenGrafo();
            mapaPendiente = true;
            return;
        }

        cargandoDistancias = true;
        StateHasChanged();

        int[][] matriz;
        bool porCarretera;
        string? aviso = null;

        try
        {
            matriz = await new ServicioRutasOsrm(Http).ObtenerMatrizDistanciasKmAsync(ciudadesTSP);
            porCarretera = true;
        }
        catch (Exception ex)
        {
            matriz = ConstruirMatrizEnLineaRecta();
            porCarretera = false;
            aviso = $"No se pudieron obtener las distancias por carretera ({ex.Message}). Se usan distancias en línea recta.";
        }

        if (version != versionMatriz)
            return;

        matrizActual = matriz;
        distanciasPorCarretera = porCarretera;
        avisoDistancias = aviso;
        cargandoDistancias = false;
        ActualizarResumenGrafo();
        mapaPendiente = true;
    }

    private int[][] ConstruirMatrizEnLineaRecta()
    {
        int cantidad = ciudadesTSP.Count;
        int[][] matriz = Enumerable.Range(0, cantidad).Select(_ => new int[cantidad]).ToArray();

        for (int i = 0; i < cantidad; i++)
        {
            for (int j = i + 1; j < cantidad; j++)
            {
                double distancia = CalculosGeograficos.DistanciaKm(
                    ciudadesTSP[i].Latitud, ciudadesTSP[i].Longitud,
                    ciudadesTSP[j].Latitud, ciudadesTSP[j].Longitud);

                int distanciaKm = Math.Max(1, (int)Math.Round(distancia));
                matriz[i][j] = distanciaKm;
                matriz[j][i] = distanciaKm;
            }
        }

        return matriz;
    }

    private async Task Procesar()
    {
        if (estaProcesando)
            return;

        estaProcesando = true;
        LimpiarResultados();
        mapaPendiente = modoCiudades;
        StateHasChanged();

        try
        {
            if (matrizActual is null)
            {
                mensajeError = modoCiudades
                    ? $"Agrega al menos {MinimoCiudades} ciudades para resolver el TSP."
                    : "La matriz de adyacencia no existe.";
                return;
            }

            GrafoPonderado grafoPonderado = ConstruirGrafo();

            if (!grafoPonderado.EsGrafoValido())
            {
                mensajeError = "El grafo no es válido para TSP. Comprueba que sea conexo y que cada vértice tenga el grado mínimo necesario.";
                return;
            }

            var problema = new ProblemaTSP(grafoPonderado, verticeInicio);

            IResolver solucionador;

            if (algoritmo == AlgoritmoResolucion.FuerzaBruta)
            {
                if (problema.NumeroVertices > LimiteFuerzaBruta)
                {
                    mensajeError = advertenciaFuerzaBruta;
                    return;
                }

                solucionador = new FuerzaBrutaTSP(problema);
            }
            else
            {
                solucionador = new DosOptTSP(problema);
            }

            var timer = Stopwatch.StartNew();
            SolucionTSP? solucion = await Task.Run(() => solucionador.Resolver());
            timer.Stop();

            if (solucion is null)
            {
                mensajeError = algoritmo == AlgoritmoResolucion.FuerzaBruta
                    ? "El algoritmo no encontró un ciclo hamiltoniano. Prueba con más aristas."
                    : "2-opt no encontró una ruta inicial válida. Prueba con más aristas o usa fuerza bruta.";
                return;
            }

            ultimaSolucion = solucion.Ruta;

            if (modoCiudades && distanciasPorCarretera)
                trazadoRuta = await ObtenerTrazado(solucion.Ruta);

            ciclosStr = solucionador is FuerzaBrutaTSP fuerzaBruta
                ? fuerzaBruta.CiclosPosibles().ToString("N0")
                : null;

            algoritmoStr = algoritmo == AlgoritmoResolucion.FuerzaBruta
                ? "Fuerza bruta"
                : "2-opt";

            rutaStr = string.Join(" → ", solucion.Ruta.Select(NombreVertice));
            costoStr = solucion.CostoTotal.ToString("N0") + (modoCiudades ? " km" : "");
            tiempoStr = timer.Elapsed.ToString(@"m\:ss\:fff");
            mapaPendiente = modoCiudades;
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            estaProcesando = false;
            StateHasChanged();
        }
    }

    private async Task<double[][]?> ObtenerTrazado(List<int> ruta)
    {
        try
        {
            return await new ServicioRutasOsrm(Http).ObtenerTrazadoAsync(ciudadesTSP, ruta);
        }
        catch (Exception ex)
        {
            avisoDistancias = $"No se pudo obtener el trazado por carretera ({ex.Message}). Se dibujan líneas rectas entre ciudades.";
            return null;
        }
    }

    private GrafoPonderado ConstruirGrafo()
    {
        int n = matrizActual!.Length;
        var grafo = new GrafoPonderado(n, esDirigido);

        for (int i = 0; i < n; i++)
        {
            int primeraColumna = esDirigido ? 0 : i + 1;

            for (int j = primeraColumna; j < n; j++)
                if (i != j && matrizActual[i][j] > 0)
                    grafo.AsignarPeso(i, j, matrizActual[i][j]);
        }

        return grafo;
    }

    private void ActualizarResumenGrafo()
    {
        if (matrizActual is null)
        {
            resumenGrafo = null;
            return;
        }

        int n = matrizActual.Length;
        int aristas = 0;
        int gradoMaximo = 0;

        for (int i = 0; i < n; i++)
        {
            int salida = 0;
            int entrada = 0;

            for (int j = 0; j < n; j++)
            {
                if (i == j)
                    continue;

                if (matrizActual[i][j] > 0)
                    salida++;

                if (matrizActual[j][i] > 0)
                    entrada++;
            }

            aristas += salida;
            gradoMaximo = Math.Max(gradoMaximo, Math.Max(salida, entrada));
        }

        if (!esDirigido)
            aristas /= 2;

        string tipo = esDirigido ? "dirigido (asimétrico)" : "no dirigido";
        string detalle = !modoCiudades
            ? string.Empty
            : distanciasPorCarretera ? " · Distancias por carretera (km)" : " · Distancias en línea recta (km)";
        resumenGrafo = $"Vértices: {n} · Aristas: {aristas} · Grado máximo: {gradoMaximo} · Tipo: {tipo}{detalle}";
    }

    private string NombreVertice(int indice)
    {
        if (modoCiudades && indice >= 0 && indice < ciudadesTSP.Count)
            return ciudadesTSP[indice].Nombre;

        return indice < 26 ? ((char)('A' + indice)).ToString() : $"V{indice}";
    }

    private void LimpiarResultados()
    {
        ciclosStr = null;
        rutaStr = null;
        costoStr = null;
        tiempoStr = null;
        mensajeError = null;
        ultimaSolucion = null;
        trazadoRuta = null;
        algoritmoStr = string.Empty;
    }

    protected override async Task OnAfterRenderAsync(bool primerRender)
    {
        if (modoCiudadesAnterior && !modoCiudades)
            await DestruirMapaCiudades();

        modoCiudadesAnterior = modoCiudades;

        if (modoCiudades && (primerRender || mapaPendiente))
        {
            mapaPendiente = false;
            await DibujarMapaCiudades();
        }
    }

    private async Task DibujarMapaCiudades()
    {
        try
        {
            moduloMapa ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/mapaOSM.js");

            var datos = ciudadesTSP
                .Select(ciudad => new
                {
                    nombre = ciudad.Nombre,
                    lat = ciudad.Latitud,
                    lon = ciudad.Longitud
                })
                .ToArray();

            int[] ruta = ultimaSolucion?.ToArray() ?? Array.Empty<int>();

            await moduloMapa.InvokeVoidAsync("mostrarMapa", "mapa-tsp-ciudades", datos, ruta, trazadoRuta);
            mensajeMapa = null;
        }
        catch (Exception ex)
        {
            mensajeMapa = $"No se pudo dibujar el mapa: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DestruirMapaCiudades()
    {
        if (moduloMapa is null)
            return;

        try
        {
            await moduloMapa.InvokeVoidAsync("destruirMapa", "mapa-tsp-ciudades");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (moduloMapa is null)
            return;

        try
        {
            await moduloMapa.InvokeVoidAsync("destruirMapa", "mapa-tsp-ciudades");
            await moduloMapa.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
