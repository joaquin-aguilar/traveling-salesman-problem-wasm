<div class="barra-superior">
    <div class="barra-contenido">
        <a class="navbar-brand" href="">Problema del agente viajero</a>

        <button title="Navigation menu"
                class="navbar-toggler"
                aria-label="Mostrar u ocultar menú"
                @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <nav class="@NavMenuCssClass nav-principal" @onclick="ToggleNavMenu">
            <div class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Acerca del problema
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="tsp">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> TSP
                </NavLink>
            </div>
        </nav>
    </div>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? null : "abierto";

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
